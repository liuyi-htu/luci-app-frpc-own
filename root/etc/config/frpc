config main 'main'
	option enabled '0'
	option server_addr ''
	option server_port '7000'
	option user ''
	option auth_mode 'metadatas'
	option token ''
	option login_fail_exit 'true'
	option tls_enable 'true'
	option log_level 'info'
	option log_max_days '3'

# auth_mode: metadatas for per-user keys, or auth for the global frps token.

config proxy 'ssh'
	option name 'ssh'
	option type 'tcp'
	option local_ip '127.0.0.1'
	option local_port '22'
	option remote_port '20000'
	option enabled '1'
