config main 'main'
	option enabled '0'
	option config_mode 'uci'
	option server_addr 'vps1.2468999.xyz'
	option server_port '62990'
	option user 'test'
	option auth_mode 'metadatas'
	option token ''
	option login_fail_exit 'true'
	option tls_enable 'true'
	option log_level 'info'
	option log_max_days '3'

# auth_mode 可选：metadatas 或 auth。
# metadatas 使用 frps 用户插件的独立客户端密钥；auth 使用 FRPS 全局 auth.token。
# config_mode 可选：uci 或 raw。raw 使用 /etc/frp-stack/frpc.toml。

config proxy 'tcp_62932'
	option name '62932_tcp'
	option type 'tcp'
	option local_ip '192.168.10.1'
	option local_port '62932'
	option remote_port '20000'
	option enabled '1'

config proxy 'udp_62932'
	option name '62932_udp'
	option type 'udp'
	option local_ip '192.168.10.1'
	option local_port '62932'
	option remote_port '20000'
	option enabled '1'
