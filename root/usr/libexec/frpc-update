#!/bin/sh

set -u
. /usr/libexec/frpc-process

LOG=/var/log/update.log
RAM_DIR=/tmp/frpc/update
LOCK=$RAM_DIR/lock
STATUS=$RAM_DIR/status
WORKDIR=
UPLOAD=

timestamp() {
	date '+%Y-%m-%d %H:%M:%S'
}

log() {
	mkdir -p /var/log
	printf '%s %s\n' "$(timestamp)" "$*" >> "$LOG"
	/usr/libexec/frpc-log-limit trim
}

set_progress() {
	local state="$1" percent="$2" tmp
	shift 2
	tmp="${STATUS}.$$"
	printf '%s\t%s\t%s\n' "$state" "$percent" "$*" > "$tmp" && mv -f "$tmp" "$STATUS"
}

cleanup() {
	[ -n "$WORKDIR" ] && rm -rf "$WORKDIR"
	[ -n "$UPLOAD" ] && rm -f "$UPLOAD"
	rm -f "${STATUS}.$$"
	rmdir "$LOCK" 2>/dev/null || true
}

fail() {
	log "Update failed: $*"
	set_progress error 100 "Update failed: $*"
	exit 1
}

normalize_version() {
	printf '%s\n' "$1" | sed -n 's/.*[vV]*\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n 1
}

version_gt() {
	awk -v left="$1" -v right="$2" 'BEGIN {
		split(left, a, "."); split(right, b, ".")
		for (i = 1; i <= 3; i++) {
			if ((a[i] + 0) > (b[i] + 0)) exit 0
			if ((a[i] + 0) < (b[i] + 0)) exit 1
		}
		exit 1
	}'
}

frpc_version() {
	[ -x "$1" ] || return 1
	normalize_version "$("$1" -v 2>&1)"
}

release_arch() {
	case "$(uname -m)" in
		aarch64|arm64) echo arm64 ;;
		x86_64|amd64) echo amd64 ;;
		armv7*|armv6*|arm) echo arm ;;
		mipsel|mipsle) echo mipsle ;;
		mips) echo mips ;;
		riscv64) echo riscv64 ;;
		*) return 1 ;;
	esac
}

extract_candidate() {
	archive="$1"
	member="$(tar -tzf "$archive" 2>/dev/null | awk '/(^|\/)frpc$/ { print; exit }')"
	[ -n "$member" ] || return 1
	case "$member" in
		/*|*../*) return 1 ;;
	esac
	tar -xzf "$archive" -C "$WORKDIR" "$member" >/dev/null 2>&1 || return 1
	CANDIDATE="$WORKDIR/$member"
	[ -f "$CANDIDATE" ] || return 1
}

install_candidate() {
	set_progress running 75 'Verifying candidate frpc...'
	chmod 0755 "$CANDIDATE" || fail 'Failed to make the candidate executable'
	candidate_version="$(frpc_version "$CANDIDATE")"
	[ -n "$candidate_version" ] || fail 'The candidate is not a valid frpc executable'
	current_version="$(frpc_version /usr/bin/frpc 2>/dev/null || true)"
	if [ -n "$current_version" ] && ! version_gt "$candidate_version" "$current_version"; then
		log "Current frpc $current_version is not older than candidate $candidate_version. No update needed."
		set_progress success 100 "Current frpc $current_version is up to date."
		return 0
	fi

	was_running=0
	frpc_is_running && was_running=1
	set_progress running 82 'Stopping frpc service...'
	[ "$was_running" -eq 0 ] || /etc/init.d/frpc stop >/dev/null 2>&1 || fail 'Failed to stop frpc'

	if [ -x /usr/bin/frpc ]; then
		cp /usr/bin/frpc "$WORKDIR/frpc.backup" || fail 'Failed to back up current frpc'
		chmod 0755 "$WORKDIR/frpc.backup"
	fi
	set_progress running 88 "Installing frpc $candidate_version..."
	if ! cp "$CANDIDATE" /usr/bin/frpc || ! chmod 0755 /usr/bin/frpc; then
		if [ -f "$WORKDIR/frpc.backup" ]; then
			cp "$WORKDIR/frpc.backup" /usr/bin/frpc >/dev/null 2>&1 || true
			chmod 0755 /usr/bin/frpc >/dev/null 2>&1 || true
		else
			rm -f /usr/bin/frpc
		fi
		[ "$was_running" -eq 0 ] || /etc/init.d/frpc start >/dev/null 2>&1 || true
		fail 'Failed to write new frpc. Attempted to restore the previous version.'
	fi

	if [ "$was_running" -eq 1 ]; then
		set_progress running 94 'Starting new frpc...'
		/etc/init.d/frpc start >/dev/null 2>&1
		sleep 2
		if ! frpc_is_running; then
			log 'New frpc failed to start. Rolling back.'
			[ -f "$WORKDIR/frpc.backup" ] || fail 'Startup failed and no backup is available'
			cp "$WORKDIR/frpc.backup" /usr/bin/frpc
			chmod 0755 /usr/bin/frpc
			/etc/init.d/frpc start >/dev/null 2>&1 || true
			fail 'New frpc failed to start. Previous version restored.'
		fi
	fi
	log "frpc updated from ${current_version:-Not installed} to $candidate_version."
	set_progress success 100 "frpc updated to $candidate_version."
}

[ "$#" -ge 1 ] || { echo "usage: $0 online | local FILE" >&2; exit 2; }
mkdir -p "$RAM_DIR" || { echo 'Failed to create temporary update directory' >&2; exit 1; }
chmod 0700 /tmp/frpc "$RAM_DIR" 2>/dev/null || true
mkdir "$LOCK" 2>/dev/null || { log 'An update is already in progress.'; exit 1; }
trap cleanup EXIT INT TERM
WORKDIR="$(mktemp -d "$RAM_DIR/work.XXXXXX")" || fail 'Failed to create temporary work directory'
mode="$1"
set_progress running 5 'Update started.'

case "$mode" in
	online)
		log 'Checking for frpc online updates.'
		set_progress running 15 'Checking the latest GitHub release...'
		metadata="$WORKDIR/release.json"
		uclient-fetch -q -O "$metadata" 'https://api.github.com/repos/fatedier/frp/releases/latest' || fail 'Failed to query the latest GitHub release'
		set_progress running 25 'Parsing release information...'
		latest="$(jsonfilter -i "$metadata" -e '@.tag_name' 2>/dev/null | sed 's/^[vV]//')"
		latest="$(normalize_version "$latest")"
		[ -n "$latest" ] || fail 'Failed to parse the latest version'
		current="$(frpc_version /usr/bin/frpc 2>/dev/null || true)"
		if [ -n "$current" ] && ! version_gt "$latest" "$current"; then
			log "Current frpc $current is not older than the latest official release $latest. No update needed."
			set_progress success 100 "Current frpc $current is the latest official release."
			exit 0
		fi
		set_progress running 35 "Found frpc $latest. Detecting system architecture..."
		arch="$(release_arch)" || fail 'Online update does not support this CPU architecture'
		archive="$WORKDIR/frp.tar.gz"
		url="https://github.com/fatedier/frp/releases/download/v${latest}/frp_${latest}_linux_${arch}.tar.gz"
		set_progress running 45 "Downloading frpc $latest..."
		uclient-fetch -q -O "$archive" "$url" || fail 'Failed to download the latest release'
		set_progress running 68 'Download complete. Extracting...'
		extract_candidate "$archive" || fail 'No valid frpc executable found in the download'
		install_candidate
		;;
	local)
		[ "$#" -eq 2 ] || fail 'Missing upload'
		UPLOAD="$2"
		case "$UPLOAD" in /tmp/frpc/uploads/frpc-upload.*) ;; *) fail 'Invalid upload path' ;; esac
		[ -s "$UPLOAD" ] || fail 'The uploaded file is empty'
		log 'Checking uploaded frpc.'
		set_progress running 35 'Reading upload...'
		if ! extract_candidate "$UPLOAD"; then
			CANDIDATE="$WORKDIR/frpc"
			cp "$UPLOAD" "$CANDIDATE" || fail 'Failed to read upload'
		fi
		install_candidate
		;;
	*)
		fail 'Unsupported update method'
		;;
esac
