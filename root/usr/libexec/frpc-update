#!/bin/sh

set -u

LOG=/var/log/update.log
RAM_DIR=/tmp/frpc/update
LOCK=$RAM_DIR/lock
STATUS=$RAM_DIR/status
WORKDIR=
UPLOAD=

timestamp() {
	date '+%Y-%m-%d %H:%M:%S'
}

log() {
	mkdir -p /var/log
	printf '%s %s\n' "$(timestamp)" "$*" >> "$LOG"
}

set_progress() {
	local state="$1" percent="$2" tmp
	shift 2
	tmp="${STATUS}.$$"
	printf '%s\t%s\t%s\n' "$state" "$percent" "$*" > "$tmp" && mv -f "$tmp" "$STATUS"
}

cleanup() {
	[ -n "$WORKDIR" ] && rm -rf "$WORKDIR"
	[ -n "$UPLOAD" ] && rm -f "$UPLOAD"
	rm -f "${STATUS}.$$"
	rmdir "$LOCK" 2>/dev/null || true
}

fail() {
	log "更新失败：$*"
	set_progress error 100 "更新失败：$*"
	exit 1
}

normalize_version() {
	printf '%s\n' "$1" | sed -n 's/.*[vV]*\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n 1
}

version_gt() {
	awk -v left="$1" -v right="$2" 'BEGIN {
		split(left, a, "."); split(right, b, ".")
		for (i = 1; i <= 3; i++) {
			if ((a[i] + 0) > (b[i] + 0)) exit 0
			if ((a[i] + 0) < (b[i] + 0)) exit 1
		}
		exit 1
	}'
}

frpc_version() {
	[ -x "$1" ] || return 1
	normalize_version "$("$1" -v 2>&1)"
}

release_arch() {
	case "$(uname -m)" in
		aarch64|arm64) echo arm64 ;;
		x86_64|amd64) echo amd64 ;;
		armv7*|armv6*|arm) echo arm ;;
		mipsel|mipsle) echo mipsle ;;
		mips) echo mips ;;
		riscv64) echo riscv64 ;;
		*) return 1 ;;
	esac
}

extract_candidate() {
	archive="$1"
	member="$(tar -tzf "$archive" 2>/dev/null | awk '/(^|\/)frpc$/ { print; exit }')"
	[ -n "$member" ] || return 1
	case "$member" in
		/*|*../*) return 1 ;;
	esac
	tar -xzf "$archive" -C "$WORKDIR" "$member" >/dev/null 2>&1 || return 1
	CANDIDATE="$WORKDIR/$member"
	[ -f "$CANDIDATE" ] || return 1
}

install_candidate() {
	set_progress running 75 '正在校验候选 frpc…'
	chmod 0755 "$CANDIDATE" || fail '无法设置候选文件执行权限'
	candidate_version="$(frpc_version "$CANDIDATE")"
	[ -n "$candidate_version" ] || fail '候选文件不是有效的 frpc'
	current_version="$(frpc_version /usr/bin/frpc 2>/dev/null || true)"
	if [ -n "$current_version" ] && ! version_gt "$candidate_version" "$current_version"; then
		log "当前 frpc $current_version 不低于待安装版本 $candidate_version，无需更新。"
		set_progress success 100 "当前 frpc $current_version 已是最新版本。"
		return 0
	fi

	was_running=0
	pidof frpc >/dev/null 2>&1 && was_running=1
	set_progress running 82 '正在停止 frpc 服务…'
	[ "$was_running" -eq 0 ] || /etc/init.d/frpc stop >/dev/null 2>&1 || fail '停止 frpc 失败'

	if [ -x /usr/bin/frpc ]; then
		cp /usr/bin/frpc "$WORKDIR/frpc.backup" || fail '备份当前 frpc 失败'
		chmod 0755 "$WORKDIR/frpc.backup"
	fi
	set_progress running 88 "正在安装 frpc $candidate_version…"
	if ! cp "$CANDIDATE" /usr/bin/frpc || ! chmod 0755 /usr/bin/frpc; then
		if [ -f "$WORKDIR/frpc.backup" ]; then
			cp "$WORKDIR/frpc.backup" /usr/bin/frpc >/dev/null 2>&1 || true
			chmod 0755 /usr/bin/frpc >/dev/null 2>&1 || true
		else
			rm -f /usr/bin/frpc
		fi
		[ "$was_running" -eq 0 ] || /etc/init.d/frpc start >/dev/null 2>&1 || true
		fail '写入新版 frpc 失败，已尝试恢复旧版本'
	fi

	if [ "$was_running" -eq 1 ]; then
		set_progress running 94 '正在启动新版 frpc…'
		/etc/init.d/frpc start >/dev/null 2>&1
		sleep 2
		if ! pidof frpc >/dev/null 2>&1; then
			log '新版 frpc 启动失败，正在回滚。'
			[ -f "$WORKDIR/frpc.backup" ] || fail '启动失败且没有可用备份'
			cp "$WORKDIR/frpc.backup" /usr/bin/frpc
			chmod 0755 /usr/bin/frpc
			/etc/init.d/frpc start >/dev/null 2>&1 || true
			fail '新版 frpc 启动失败，已恢复旧版本'
		fi
	fi
	log "frpc 已从 ${current_version:-未安装} 更新到 $candidate_version。"
	set_progress success 100 "frpc 已更新到 $candidate_version。"
}

[ "$#" -ge 1 ] || { echo "usage: $0 online | local FILE" >&2; exit 2; }
mkdir -p "$RAM_DIR" || { echo '无法创建内存更新目录' >&2; exit 1; }
chmod 0700 /tmp/frpc "$RAM_DIR" 2>/dev/null || true
mkdir "$LOCK" 2>/dev/null || { log '已有更新任务正在执行。'; exit 1; }
trap cleanup EXIT INT TERM
WORKDIR="$(mktemp -d "$RAM_DIR/work.XXXXXX")" || fail '无法创建内存工作目录'
mode="$1"
set_progress running 5 '更新任务已启动。'

case "$mode" in
	online)
		log '开始检查 frpc 在线更新。'
		set_progress running 15 '正在查询 GitHub 最新版本…'
		metadata="$WORKDIR/release.json"
		uclient-fetch -q -O "$metadata" 'https://api.github.com/repos/fatedier/frp/releases/latest' || fail '查询 GitHub 最新版本失败'
		set_progress running 25 '正在解析最新版本信息…'
		latest="$(jsonfilter -i "$metadata" -e '@.tag_name' 2>/dev/null | sed 's/^[vV]//')"
		latest="$(normalize_version "$latest")"
		[ -n "$latest" ] || fail '无法解析最新版号'
		current="$(frpc_version /usr/bin/frpc 2>/dev/null || true)"
		if [ -n "$current" ] && ! version_gt "$latest" "$current"; then
			log "当前 frpc $current 不低于官方最新版 $latest，无需更新。"
			set_progress success 100 "当前 frpc $current 已是官方最新版。"
			exit 0
		fi
		set_progress running 35 "发现新版 frpc $latest，正在确认系统架构…"
		arch="$(release_arch)" || fail '当前 CPU 架构不受在线更新支持'
		archive="$WORKDIR/frp.tar.gz"
		url="https://github.com/fatedier/frp/releases/download/v${latest}/frp_${latest}_linux_${arch}.tar.gz"
		set_progress running 45 "正在下载 frpc $latest…"
		uclient-fetch -q -O "$archive" "$url" || fail '下载最新版失败'
		set_progress running 68 '下载完成，正在解压…'
		extract_candidate "$archive" || fail '下载包中未找到有效 frpc'
		install_candidate
		;;
	local)
		[ "$#" -eq 2 ] || fail '缺少上传文件'
		UPLOAD="$2"
		case "$UPLOAD" in /tmp/frpc/uploads/frpc-upload.*) ;; *) fail '上传文件路径无效' ;; esac
		[ -s "$UPLOAD" ] || fail '上传文件为空'
		log '开始检查本地上传的 frpc。'
		set_progress running 35 '正在读取上传文件…'
		if ! extract_candidate "$UPLOAD"; then
			CANDIDATE="$WORKDIR/frpc"
			cp "$UPLOAD" "$CANDIDATE" || fail '读取上传文件失败'
		fi
		install_candidate
		;;
	*)
		fail '不支持的更新方式'
		;;
esac
