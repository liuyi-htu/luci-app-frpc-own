#!/bin/sh

set -u

INIT=/etc/init.d/frpc
UPDATE=/usr/libexec/frpc-update
ENFORCER=/usr/libexec/frpc-enforce-log
RAW_CONFIG=/etc/frp-stack/frpc.toml
RAM_ROOT=/tmp/frpc
RUNTIME_CONFIG=$RAM_ROOT/runtime/frpc.toml
CONFIG_UPLOAD=$RAM_ROOT/uploads/config-upload
FRPC_UPLOAD=$RAM_ROOT/uploads/frpc-upload.tar.gz
VERIFY_DIR=$RAM_ROOT/verify
UPDATE_STATUS=$RAM_ROOT/update/status
UPDATE_LOCK=$RAM_ROOT/update/lock

fail() {
	printf '%s\n' "$*" >&2
	exit 1
}

prepare_ram_dirs() {
	mkdir -p "$RAM_ROOT/runtime" "$RAM_ROOT/uploads" "$RAM_ROOT/update" "$VERIFY_DIR" "$RAM_ROOT/enforce" || fail '无法创建内存工作目录'
	chmod 0700 "$RAM_ROOT" "$RAM_ROOT/runtime" "$RAM_ROOT/uploads" "$RAM_ROOT/update" "$VERIFY_DIR" "$RAM_ROOT/enforce"
}

is_running() {
	pidof frpc >/dev/null 2>&1
}

is_enabled() {
	[ -e /etc/rc.d/S??frpc ]
}

service_action() {
	local action="$1"
	case "$action" in
		start|restart)
			uci -q set frpc.main.enabled='1'
			uci -q commit frpc
			;;
		stop|enable|disable) ;;
		*) fail '不支持的服务操作' ;;
	esac
	"$INIT" "$action" >/dev/null 2>&1 || fail "frpc $action 执行失败"
	if [ "$action" = start ] || [ "$action" = restart ]; then
		sleep 1
		is_running || fail 'frpc 启动失败，请查看系统日志'
	fi
}

save_raw_config() {
	[ -s "$CONFIG_UPLOAD" ] || fail '配置文件为空'
	local size verify output backup was_running=0 had_raw=0
	size="$(wc -c < "$CONFIG_UPLOAD")"
	[ "$size" -le 1048576 ] || fail '配置文件不能超过 1 MiB'
	verify="$VERIFY_DIR/config.$$"
	output="$VERIFY_DIR/output.$$.log"
	backup="$VERIFY_DIR/raw-backup.$$"
	trap 'rm -f "$VERIFY_DIR/config.$$" "$VERIFY_DIR/output.$$.log" "$VERIFY_DIR/raw-backup.$$" "$CONFIG_UPLOAD"' EXIT INT TERM
	cp "$CONFIG_UPLOAD" "$verify" || fail '读取临时配置失败'
	chmod 0600 "$verify"
	"$ENFORCER" "$verify" || fail '无法强制写入日志配置'
	/usr/bin/frpc verify -c "$verify" >"$output" 2>&1 || {
		local detail
		detail="$(tail -n 20 "$output")"
		fail "配置校验失败：${detail:-frpc verify 执行失败}"
	}
	mkdir -p /etc/frp-stack || fail '创建配置目录失败'
	if [ -e "$RAW_CONFIG" ]; then
		had_raw=1
		cp "$RAW_CONFIG" "$backup" || fail '无法在内存中备份原配置文件'
		chmod 0600 "$backup"
	fi
	is_running && was_running=1
	[ "$was_running" -eq 0 ] || "$INIT" stop >/dev/null 2>&1 || fail '停止 frpc 失败，未修改配置'
	if ! cp "$verify" "$RAW_CONFIG" || ! chmod 0600 "$RAW_CONFIG"; then
		if [ "$had_raw" -eq 1 ]; then
			cp "$backup" "$RAW_CONFIG" >/dev/null 2>&1 || true
			chmod 0600 "$RAW_CONFIG" >/dev/null 2>&1 || true
		else
			rm -f "$RAW_CONFIG"
		fi
		[ "$was_running" -eq 0 ] || "$INIT" start >/dev/null 2>&1 || true
		fail '写入配置文件失败，已尝试恢复原配置'
	fi
	uci -q set frpc.main.config_mode='raw'
	uci -q set frpc.main.enabled='1'
	uci -q commit frpc || {
		[ "$was_running" -eq 0 ] || "$INIT" start >/dev/null 2>&1 || true
		fail '配置已写入，但保存配置模式失败'
	}
	if [ "$was_running" -eq 1 ]; then
		"$INIT" start >/dev/null 2>&1 || fail '配置已保存，但 frpc 自动重启失败'
		sleep 1
		is_running || fail '配置已保存，但 frpc 自动重启失败'
	fi
	printf '%s\n' '配置校验通过并已保存'
}

read_log() {
	local path
	case "${1:-}" in
		frpc) path=/var/log/frpc.log ;;
		update) path=/var/log/update.log ;;
		*) fail '不支持的日志类型' ;;
	esac
	[ -f "$path" ] || exit 0
	tail -c 524288 "$path" 2>/dev/null | tail -n 50
}

clear_log() {
	local path
	case "${1:-}" in
		frpc) path=/var/log/frpc.log ;;
		update) path=/var/log/update.log ;;
		*) fail '不支持的日志类型' ;;
	esac
	mkdir -p /var/log
	: > "$path" || fail '清空日志失败'
}

prepare_ram_dirs

case "${1:-}" in
	status)
		running=0; enabled=0
		is_running && running=1
		is_enabled && enabled=1
		version="$(/usr/bin/frpc -v 2>/dev/null | head -n 1 || true)"
		mode="$(uci -q get frpc.main.config_mode || echo uci)"
		printf '%s\t%s\t%s\t%s\n' "$running" "$enabled" "${version:-未安装}" "$mode"
		;;
	service)
		[ "$#" -eq 2 ] || fail '缺少服务操作'
		service_action "$2"
		;;
	restart-if-running)
		if is_running; then service_action restart; fi
		;;
	read-config)
		mode="$(uci -q get frpc.main.config_mode || echo uci)"
		if [ "$mode" = raw ] && [ -f "$RAW_CONFIG" ]; then
			cat "$RAW_CONFIG"
		elif [ -f "$RUNTIME_CONFIG" ]; then
			cat "$RUNTIME_CONFIG"
		fi
		;;
	save-config)
		[ "$#" -eq 1 ] || fail '参数无效'
		save_raw_config
		;;
	read-log)
		[ "$#" -eq 2 ] || fail '缺少日志类型'
		read_log "$2"
		;;
	clear-log)
		[ "$#" -eq 2 ] || fail '缺少日志类型'
		clear_log "$2"
		;;
	update-online)
		[ "$#" -eq 1 ] || fail '参数无效'
		[ ! -d "$UPDATE_LOCK" ] || fail '已有更新任务正在执行。'
		printf '%s\t%s\t%s\n' running 1 '正在启动在线更新任务…' > "$UPDATE_STATUS"
		/sbin/start-stop-daemon -S -b -O /dev/null -x "$UPDATE" -- online || fail '无法启动在线更新任务'
		printf '%s\n' '在线更新任务已启动'
		;;
	update-local)
		[ "$#" -eq 1 ] || fail '参数无效'
		[ ! -d "$UPDATE_LOCK" ] || fail '已有更新任务正在执行。'
		[ -s "$FRPC_UPLOAD" ] || fail '上传文件为空'
		printf '%s\t%s\t%s\n' running 1 '正在启动本地更新任务…' > "$UPDATE_STATUS"
		/sbin/start-stop-daemon -S -b -O /dev/null -x "$UPDATE" -- local "$FRPC_UPLOAD" || fail '无法启动本地更新任务'
		printf '%s\n' '上传文件已接收，更新任务已启动'
		;;
	update-status)
		[ "$#" -eq 1 ] || fail '参数无效'
		if [ -s "$UPDATE_STATUS" ]; then
			sed -n '1p' "$UPDATE_STATUS"
		elif [ -d "$UPDATE_LOCK" ]; then
			printf '%s\t%s\t%s\n' running 1 '更新任务正在运行…'
		else
			printf '%s\t%s\t%s\n' idle 0 '尚未开始更新。'
		fi
		;;
	*)
		fail '用法：frpc-ui {status|service|restart-if-running|read-config|save-config|read-log|clear-log|update-online|update-local|update-status}'
		;;
esac
