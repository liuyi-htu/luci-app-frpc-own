#!/bin/sh

set -u

INIT=/etc/init.d/frpc
UPDATE=/usr/libexec/frpc-update
RAM_ROOT=/tmp/frpc
RUNTIME_CONFIG=$RAM_ROOT/runtime/frpc.toml
AUTH_UPLOAD=$RAM_ROOT/uploads/auth-upload.json
FRPC_UPLOAD=$RAM_ROOT/uploads/frpc-upload.tar.gz
VERIFY_DIR=$RAM_ROOT/verify
UPDATE_STATUS=$RAM_ROOT/update/status
UPDATE_LOCK=$RAM_ROOT/update/lock

fail() {
	printf '%s\n' "$*" >&2
	exit 1
}

prepare_ram_dirs() {
	mkdir -p "$RAM_ROOT/runtime" "$RAM_ROOT/uploads" "$RAM_ROOT/update" "$VERIFY_DIR" "$RAM_ROOT/enforce" || fail 'Failed to create temporary work directory'
	chmod 0700 "$RAM_ROOT" "$RAM_ROOT/runtime" "$RAM_ROOT/uploads" "$RAM_ROOT/update" "$VERIFY_DIR" "$RAM_ROOT/enforce"
}

is_running() {
	pidof frpc >/dev/null 2>&1
}

is_enabled() {
	[ -e /etc/rc.d/S??frpc ]
}

service_action() {
	local action="$1"
	case "$action" in
		start|restart)
			uci -q set frpc.main.enabled='1'
			uci -q commit frpc
			;;
		stop|enable|disable) ;;
		*) fail 'Unsupported service action' ;;
	esac
	"$INIT" "$action" >/dev/null 2>&1 || fail "frpc $action failed"
	if [ "$action" = start ] || [ "$action" = restart ]; then
		sleep 1
		is_running || fail 'frpc failed to start. Check the system log.'
	fi
}

save_authentication() {
	trap 'rm -f "$AUTH_UPLOAD"' EXIT INT TERM
	is_running && fail 'frpc is running. Stop the service before saving configuration'
	[ -s "$AUTH_UPLOAD" ] || fail 'Authentication is empty'
	[ "$(wc -c < "$AUTH_UPLOAD")" -le 16384 ] || fail 'Authentication data is too large'
	local fields='server_addr server_port user auth_mode token tls_enable login_fail_exit log_level log_max_days'
	local field value
	# Validate every field before changing UCI. Only this whitelist is persisted;
	# proxy/visitor changes staged in the LuCI RPC session remain untouched.
	for field in $fields; do
		value="$(jsonfilter -i "$AUTH_UPLOAD" -e "@.$field" 2>/dev/null)" || fail 'Invalid authentication data'
		[ -n "$value" ] || fail "Authentication field is required: $field"
		[ "$(printf '%s' "$value" | tr -d '\000-\037\177')" = "$value" ] || fail "Authentication field contains control characters: $field"
		case "$field" in
			server_addr) printf '%s' "$value" | grep -q '[[:space:]]' && fail 'Server address must not contain whitespace' ;;
			server_port|log_max_days)
				case "$value" in *[!0-9]*) fail "Invalid numeric field: $field" ;; esac
				[ "${#value}" -le 5 ] || fail "Numeric field is out of range: $field"
				if [ "$field" = server_port ]; then
					[ "$value" -ge 1 ] && [ "$value" -le 65535 ] || fail 'Server port is out of range'
				else
					[ "$value" -le 3650 ] || fail 'Log retention is out of range'
				fi ;;
			user) [ "${#value}" -le 64 ] || fail 'User must not exceed 64 characters' ;;
			auth_mode) case "$value" in metadatas|auth) ;; *) fail 'Invalid authentication method' ;; esac ;;
			tls_enable|login_fail_exit) case "$value" in true|false) ;; *) fail 'Invalid boolean value' ;; esac ;;
			log_level) case "$value" in trace|debug|info|warn|error) ;; *) fail 'Invalid log level' ;; esac ;;
		esac
	done
	is_running && fail 'frpc is running. Stop the service before saving configuration'
	for field in $fields; do
		value="$(jsonfilter -i "$AUTH_UPLOAD" -e "@.$field" 2>/dev/null)" || fail 'Failed to read authentication data'
		uci -q set "frpc.main.$field=$value" >/dev/null 2>&1 || fail 'Failed to write authentication data'
	done
	uci -q set frpc.main.enabled='1' || fail 'Failed to set the enabled flag'
	uci -q commit frpc || fail 'Failed to save authentication'
	printf '%s\n' 'Authentication saved. You can start the service manually.'
}

read_log() {
	local path
	case "${1:-}" in
		frpc) path=/var/log/frpc.log ;;
		update) path=/var/log/update.log ;;
		*) fail 'Unsupported log type' ;;
	esac
	[ -f "$path" ] || exit 0
	/usr/libexec/frpc-log-limit trim
	tail -c 524288 "$path" 2>/dev/null | tail -n 50
}

clear_log() {
	local path
	case "${1:-}" in
		frpc) path=/var/log/frpc.log ;;
		update) path=/var/log/update.log ;;
		*) fail 'Unsupported log type' ;;
	esac
	mkdir -p /var/log
	: > "$path" || fail 'Failed to clear log'
}

prepare_ram_dirs

case "${1:-}" in
	status)
		running=0; enabled=0
		is_running && running=1
		is_enabled && enabled=1
		version="$(/usr/bin/frpc -v 2>/dev/null | head -n 1 || true)"
		printf '%s\t%s\t%s\n' "$running" "$enabled" "${version:-Not installed}"
		;;
	service)
		[ "$#" -eq 2 ] || fail 'Missing service action'
		service_action "$2"
		;;
	restart-if-running)
		if is_running; then service_action restart; fi
		;;
	read-runtime-config|read-config)
		[ "$#" -eq 1 ] || fail 'Invalid arguments'
		if ! is_running; then
			"$INIT" generate_runtime_config || fail 'Failed to generate runtime configuration. Check authentication and proxy settings.'
		fi
		if [ -f "$RUNTIME_CONFIG" ]; then
			cat "$RUNTIME_CONFIG"
		fi
		;;
	save-auth)
		[ "$#" -eq 1 ] || fail 'Invalid arguments'
		save_authentication
		;;
	read-log)
		[ "$#" -eq 2 ] || fail 'Missing log type'
		read_log "$2"
		;;
	clear-log)
		[ "$#" -eq 2 ] || fail 'Missing log type'
		clear_log "$2"
		;;
	update-online)
		[ "$#" -eq 1 ] || fail 'Invalid arguments'
		[ ! -d "$UPDATE_LOCK" ] || fail 'An update is already in progress.'
		printf '%s\t%s\t%s\n' running 1 'Starting online update...' > "$UPDATE_STATUS"
		/sbin/start-stop-daemon -S -b -O /dev/null -x "$UPDATE" -- online || fail 'Failed to start online update'
		printf '%s\n' 'Online update started'
		;;
	update-local)
		[ "$#" -eq 1 ] || fail 'Invalid arguments'
		[ ! -d "$UPDATE_LOCK" ] || fail 'An update is already in progress.'
		[ -s "$FRPC_UPLOAD" ] || fail 'The uploaded file is empty'
		printf '%s\t%s\t%s\n' running 1 'Starting local update...' > "$UPDATE_STATUS"
		/sbin/start-stop-daemon -S -b -O /dev/null -x "$UPDATE" -- local "$FRPC_UPLOAD" || fail 'Failed to start local update'
		printf '%s\n' 'Upload received. Update started.'
		;;
	update-status)
		[ "$#" -eq 1 ] || fail 'Invalid arguments'
		if [ -s "$UPDATE_STATUS" ]; then
			sed -n '1p' "$UPDATE_STATUS"
		elif [ -d "$UPDATE_LOCK" ]; then
			printf '%s\t%s\t%s\n' running 1 'Update is in progress...'
		else
			printf '%s\t%s\t%s\n' idle 0 'No update has started.'
		fi
		;;
	*)
		fail 'Usage: frpc-ui {status|service|restart-if-running|read-runtime-config|save-auth|read-log|clear-log|update-online|update-local|update-status}'
		;;
esac
