{
	"luci-app-frpc-own": {
		"description": "Grant access to the frpc management application",
		"read": {
			"uci": [ "frpc" ],
			"file": {
				"/usr/libexec/frpc-ui": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "frpc" ],
			"ubus": {
				"uci": [ "commit" ]
			},
			"file": {
				"/usr/libexec/frpc-ui": [ "exec" ],
				"/tmp/frpc/uploads/auth-upload.json": [ "write", "remove" ],
				"/tmp/frpc/uploads/frpc-upload.tar.gz": [ "write", "remove" ]
			}
		}
	}
}
